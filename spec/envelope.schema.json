{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jonpol01/conductor-lm/spec/envelope.schema.json",
  "title": "Conductor task envelope v0",
  "type": "object",
  "required": ["task", "context", "fleet", "budget", "history"],
  "additionalProperties": false,
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "required": ["tokens_est", "domain"],
      "additionalProperties": false,
      "properties": {
        "tokens_est": { "type": "integer", "minimum": 0 },
        "domain": { "type": "string" },
        "artifacts": { "type": "array", "items": { "enum": ["file", "diff", "log", "dataset", "image", "none"] } },
        "criticality": { "enum": ["low", "normal", "high", "security"] },
        "flags": {
          "type": "array",
          "items": { "enum": ["privacy_required", "batch", "ambiguous"] }
        }
      }
    },
    "fleet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tier", "cost", "caps", "ctx_max"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "tier": { "enum": ["frontier", "mid", "local"] },
          "cost": { "type": "number", "minimum": 0 },
          "caps": { "type": "array", "items": { "type": "string" } },
          "ctx_max": { "type": "integer", "minimum": 1024 }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["frontier_tokens_remaining"],
      "additionalProperties": false,
      "properties": {
        "frontier_tokens_remaining": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_class", "tier", "outcome"],
        "additionalProperties": false,
        "properties": {
          "task_class": { "type": "string" },
          "tier": { "enum": ["frontier", "mid", "local"] },
          "outcome": { "enum": ["ok", "escalated", "failed"] }
        }
      }
    }
  }
}
